{
  "name": "forge-ide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:reconciliation": "node scripts/audit-reconciliation.mjs",
    "audit:contrast": "node scripts/audit-contrast.mjs",
    "verify": "npm run typecheck && npm run lint && npm run audit:reconciliation && npm run audit:contrast && npm run audit:secrets && npm run test && npm run build",
    "test:e2e": "node e2e/smoke.mjs",
    "build:preview-runtime": "node scripts/build-preview-runtime.mjs",
    "predev": "npm run build:preview-runtime",
    "prebuild": "npm run build:preview-runtime",
    "test:e2e:preview": "node e2e/preview-matrix.mjs",
    "test:rls": "bash scripts/run-rls-tests.sh",
    "test:e2e:github": "node e2e/github.mjs",
    "github:test-api": "vite-node e2e/github-server.ts",
    "test:e2e:agent": "node e2e/agent.mjs",
    "agent:test-provider": "node e2e/agent-provider.mjs",
    "test:e2e:workspace": "node e2e/workspace.mjs",
    "test:e2e:collab": "node e2e/collaboration.mjs",
    "test:e2e:devexp": "node e2e/devexp.mjs",
    "test:schema": "node scripts/check-schema-conformance.mjs",
    "test:e2e:integration": "node e2e/integration.mjs",
    "test:e2e:polish": "node e2e/polish.mjs",
    "test:e2e:persistence": "node e2e/persistence.mjs",
    "test:e2e:product": "node e2e/product.mjs",
    "test:e2e:stress": "node e2e/stress.mjs",
    "test:e2e:platform": "node e2e/platform.mjs",
    "verify:cloud": "node scripts/verify-cloud-save.mjs",
    "test:edge": "deno test --allow-env --allow-net --no-check supabase/functions/ai-proxy/index.test.ts",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "gateway:test": "npm --prefix gateway test",
    "gateway:typecheck": "npm --prefix gateway run typecheck",
    "gateway:dev": "npm --prefix gateway run dev",
    "image:workspace": "docker build -t ta-code/workspace:1 docker/workspace",
    "test:e2e:a11y": "node e2e/a11y.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild-wasm": "^0.25.12",
    "jszip": "^3.10.1",
    "lucide-react": "^0.446.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "description": "A production-grade browser-based IDE: Monaco editor, in-browser bundler, shell, version control and live preview."
}
